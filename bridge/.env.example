# Copy to bridge/.env and fill in. Read by systemd/jarvis-bridge.service (and by you, with `set -a; . ./.env`).

# Your PC's Tailscale address (`tailscale ip -4`). The bridge listens only there.
JARVIS_BIND=127.0.0.1
JARVIS_PORT=8787

# A faster-whisper model name or a local folder. "small.en" runs fine on a CPU; "large-v3-turbo" wants a GPU.
JARVIS_WHISPER=small.en

# Below 1 makes Jarvis's voice deeper.
JARVIS_VOICE_PITCH=0.98

# Only when the GPU libraries come from pip (nvidia-cublas-cu12, nvidia-cudnn-cu12):
# LD_LIBRARY_PATH=/home/you/jarvis/bridge/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/home/you/jarvis/bridge/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib
